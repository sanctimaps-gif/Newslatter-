# ─── Application ──────────────────────────────────────────────
# URL publique de l'application newsletter (liens de confirmation / désinscription)
APP_URL=https://newsletter.sanctimaps.fr
DATABASE_URL=postgresql://newsletter:motdepasse@localhost:5432/newsletter?schema=public

# ─── Administration ──────────────────────────────────────────
ADMIN_EMAIL=admin@sanctimaps.fr
# Générer avec : npm run hash-password -- "votre mot de passe"
ADMIN_PASSWORD_HASH=
# … ou, si vous ne pouvez pas lancer la commande, le mot de passe lui-même (12 caractères min.)
# ADMIN_PASSWORD=
# Chaîne aléatoire d'au moins 32 caractères : openssl rand -base64 48
SESSION_SECRET=

# ─── Scheduler ───────────────────────────────────────────────
# Secret envoyé par la tâche planifiée : Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Taille des lots, pause entre lots, durée max d'un passage du scheduler
SEND_BATCH_SIZE=100
SEND_BATCH_DELAY_MS=1000
SEND_TIME_BUDGET_MS=50000
# Au-delà de N heures après l'heure prévue, pas d'envoi automatique
SEND_WINDOW_HOURS=4
# Tentatives automatiques si SanctiMaps est indisponible (avant tout envoi)
MAX_AUTO_ATTEMPTS=3

# ─── SanctiMaps (source des données) ─────────────────────────
# Endpoint JSON sécurisé côté SanctiMaps (voir docs/sanctimaps-endpoint.md)
SANCTIMAPS_API_URL=https://sanctimaps.fr/api/newsletter/today
SANCTIMAPS_API_KEY=
SANCTIMAPS_SITE_URL=https://sanctimaps.fr
# true = données fictives (développement uniquement)
SANCTIMAPS_MOCK=false
# Origines autorisées à poster sur /api/subscribers (formulaire intégré à SanctiMaps)
ALLOWED_ORIGINS=https://sanctimaps.fr,https://www.sanctimaps.fr
# Logo affiché en haut des e-mails (URL absolue HTTPS)
LOGO_URL=

# ─── E-mail (SMTP, aucun fournisseur imposé) ─────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=newsletter@sanctimaps.fr
SMTP_FROM_NAME=SanctiMaps
# true pour le port 465 (TLS implicite), false pour 587 (STARTTLS)
SMTP_SECURE=false
# Respect des limites du serveur SMTP
SMTP_MAX_CONNECTIONS=2
SMTP_RATE_PER_SECOND=5
